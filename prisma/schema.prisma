generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews          Review[]
  entities         Entity[]
  encuestas        Encuesta[]
  respuestasEncuesta RespuestaEncuesta[]

  @@map("users")
}

model Entity {
  id        String   @id @default(uuid())
  entityId  String   @unique 
  name      String?
  type      String   // "BUSINESS" or "PERSON"
  position  String?  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations Location[]
  photos    Photo[]
  // reviews   Review[]  // Comentado temporalmente
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("entities")
}

model Location {
  id         String   @id @default(uuid())
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  address    String
  latitude   Float?
  longitude  Float?
  phone      String?
  reviews    Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locations")
}

model Photo {
  id         String   @id @default(uuid())
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  url        String
  createdAt  DateTime @default(now())

  @@map("photos")
}

model Review {
  id        String   @id @default(uuid())
  locationId String
  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Elimina la línea entity aquí temporalmente
  rating    Int      // 1-5 estrellas (positiva o negativa)
  comment   String   // solo texto y emoticones
  category  String   // SERVICE, PRODUCT, PRICE, AMBIENTE, ENTREGA
  thumbsUp  Int      @default(0)
  thumbsDown Int     @default(0)
  isApproved Boolean  @default(false) // Para aprobación sí/no del producto
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}


model Encuesta {
  id        String   @id @default(uuid())
  nombreEntidad String
  tipoEntidad String   // PRODUCTO, LOCAL, PERSONA, OTRO
  descripcion String?
  activo      Boolean  @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preguntas   Pregunta[]
  respuestas  RespuestaEncuesta[]  @relation("respuestasEncuesta")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("encuestas")
}

model Pregunta {
  id        String   @id @default(uuid())
  texto     String
  tipo      String   // ESTRELLAS, TEXTO, MULTIPLE
  obligatoria Boolean  @default(true)
  opciones  String? // JSON para opciones tipo MULTIPLE
  encuestaId String
  encuesta  Encuesta @relation(fields: [encuestaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("preguntas")
}

model RespuestaEncuesta {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encuestaId String
  encuesta  Encuesta @relation("respuestasEncuesta", fields: [encuestaId], references: [id], onDelete: Cascade)
  preguntaId String?   // Optional: for tracking which question was answered
  respuesta  String   // La respuesta del usuario (texto, ID de opción, etc.)
  tipoRespuesta String // "TEXT", "RATING", "SELECT", etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("respuestas_encuestas")
}
